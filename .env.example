# Eterno & Code Crusaders Environment Configuration Template

# Server Configuration
PORT=8080
ENV=development
API_BASE_URL=http://localhost:8080/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://eterno:eterno_secret@127.0.0.1:5434/eterno?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# Authentication & Security
JWT_SECRET=your-256-bit-jwt-secret-replace-in-production
JWT_EXPIRATION_HOURS=72

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_SECONDS=5
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_BACKOFF_SECONDS=2

# External Platform Integrations
LEETCODE_GRAPHQL_ENDPOINT=https://leetcode.com/graphql
LEETCODE_USER_AGENT=Mozilla/5.0 (compatible; EternoBot/1.0; +https://eterno.dev)
MOCK_EXTERNAL_PROVIDERS=false

# Codeforces API Credentials
CF_API_KEY=
CF_API_SECRET=

# GitHub OAuth Credentials
GH_CLIENT=
GH_SECRET=
